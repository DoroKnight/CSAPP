irmovq  $0x100, %rsp
# Set retrun address for ret
irmovq  $0x200, %rax
rmmovq  %rax, 0(%rsp)
# Set new stack pointer in 0x108
rmmovq  %rsp, 8(%rsp)
# Construct combination B
mrmovq  8(%rsp), %rsp
ret

# The target of return back
.pos 0x200
halt

# Attention:
# The lord/use hazard only appear when execute MRMOVQ and POPQ,
# the target register is used by next instruction as source register.